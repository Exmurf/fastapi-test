APP_NAME=Product CRUD API
DATABASE_URL=sqlite:///./database.db
DEBUG=false
JWT_SECRET_KEY=replace-with-secure-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

LOGIN_LIMIT = 5
LOGIN_WINDOW_SECONDS = 60

REGISTER_LIMIT = 3
REGISTER_WINDOW_SECONDS = 600

PRODUCT_READ_LIMIT = 100
PRODUCT_READ_WINDOW_SECONDS = 60

PRODUCT_WRITE_LIMIT = 30
PRODUCT_WRITE_WINDOW_SECONDS = 60